<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="DarkZenith" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={~p"/fonts/ibm-plex-sans-latin-400.woff2"}
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={~p"/fonts/ibm-plex-mono-latin-400.woff2"}
    />
    <%!-- Pre-paint theme script: external because CSP forbids inline scripts;
          parser-blocking (no defer) so it runs before first paint. --%>
    <script phx-track-static src={~p"/assets/js/theme.js"}>
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="flex min-h-svh flex-col">
    <header class="relative flex h-14 items-center justify-between gap-4 border-b border-base-content/10 px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-6 self-stretch">
        <a href={~p"/"} class="flex items-center gap-2.5">
          <.zenith_mark class="size-6" />
          <span class="hidden font-display text-sm font-medium tracking-[0.16em] sm:inline">
            DARK ZENITH
          </span>
        </a>
        <nav class="hidden self-stretch sm:flex" aria-label="Main">
          <.link
            navigate={~p"/repos"}
            aria-current={if String.starts_with?(@conn.request_path, "/repos"), do: "page"}
            class="flex items-center border-b-2 border-transparent px-1 text-sm text-base-content/70 hover:text-base-content aria-[current=page]:border-primary aria-[current=page]:text-base-content"
          >
            Repositories
          </.link>
        </nav>
      </div>

      <div class="flex items-center gap-2">
        <%!-- Global package search (docs/DESIGN_UI.md — App shell): compact
              input on md+, a disclosure icon expanding to a full-width row
              below md. Plain GET form — submits are full page loads. --%>
        <details class="md:hidden">
          <summary
            class="btn btn-ghost btn-square btn-sm list-none [&::-webkit-details-marker]:hidden"
            aria-label="Search packages"
          >
            <.icon name="hero-magnifying-glass" class="size-5" />
          </summary>
          <div class="absolute inset-x-0 top-full z-20 border-b border-base-content/10 bg-base-100 p-3">
            <form action={~p"/search"} method="get">
              <label class="sr-only" for="global-search-small">Search packages</label>
              <input
                type="search"
                id="global-search-small"
                name="q"
                placeholder="Search packages…"
                maxlength="256"
                autocomplete="off"
                data-global-search
                class="input input-sm input-bordered w-full"
              />
            </form>
          </div>
        </details>

        <div class="hidden items-center gap-3 sm:flex">
          <form action={~p"/search"} method="get" class="hidden md:block">
            <label class="sr-only" for="global-search">Search packages</label>
            <input
              type="search"
              id="global-search"
              name="q"
              placeholder="Search packages…"
              maxlength="256"
              autocomplete="off"
              data-global-search
              class="input input-sm input-bordered w-64"
            />
          </form>
          <.theme_toggle />
          <%= if @current_scope do %>
            <details class="dropdown dropdown-end">
              <summary class="btn btn-ghost btn-sm list-none font-normal [&::-webkit-details-marker]:hidden">
                <span class="max-w-[16rem] truncate">{@current_scope.user.email}</span>
                <.icon name="hero-chevron-down-micro" class="size-4 opacity-70" />
              </summary>
              <ul class="dropdown-content menu z-20 mt-1 w-52 rounded-box border border-base-content/10 bg-base-200 p-2 shadow-lg">
                <li><.link href={~p"/users/settings"}>Settings</.link></li>
                <li :if={@current_scope.user.is_admin}>
                  <.link href={~p"/admin"}>Admin</.link>
                </li>
                <li class="mt-1 border-t border-base-content/10 pt-1">
                  <.link href={~p"/users/log-out"} method="delete">Log out</.link>
                </li>
              </ul>
            </details>
          <% else %>
            <.link
              :if={DarkZenith.Accounts.registration_enabled?()}
              href={~p"/users/register"}
              class="text-sm text-base-content/70 hover:text-base-content"
            >
              Register
            </.link>
            <.link
              href={~p"/users/log-in"}
              class="text-sm text-base-content/70 hover:text-base-content"
            >
              Log in
            </.link>
          <% end %>
        </div>

        <details class="dropdown dropdown-end sm:hidden">
          <summary
            class="btn btn-ghost btn-square btn-sm list-none [&::-webkit-details-marker]:hidden"
            aria-label="Menu"
          >
            <.icon name="hero-bars-3" class="size-5" />
          </summary>
          <ul class="dropdown-content menu z-20 mt-1 w-56 rounded-box border border-base-content/10 bg-base-200 p-2 shadow-lg">
            <li><.link navigate={~p"/repos"}>Repositories</.link></li>
            <%= if @current_scope do %>
              <li><.link href={~p"/users/settings"}>Settings</.link></li>
              <li :if={@current_scope.user.is_admin}>
                <.link href={~p"/admin"}>Admin</.link>
              </li>
              <li><.link href={~p"/users/log-out"} method="delete">Log out</.link></li>
            <% else %>
              <li :if={DarkZenith.Accounts.registration_enabled?()}>
                <.link href={~p"/users/register"}>Register</.link>
              </li>
              <li><.link href={~p"/users/log-in"}>Log in</.link></li>
            <% end %>
            <li class="mt-1 border-t border-base-content/10 pt-1">
              <.theme_toggle />
            </li>
          </ul>
        </details>
      </div>
    </header>
    <div class="flex-1">
      {@inner_content}
    </div>
    <.app_footer />
  </body>
</html>
