<Layouts.flash_group flash={@flash} />

<div class="mx-auto max-w-2xl px-4 py-20 text-center space-y-6">
  <h1 class="text-4xl font-bold">Dark Zenith</h1>
  <p class="text-lg text-base-content/70">
    A self-hosted RPM package repository. Create repositories, upload packages, and point
    <code>dnf</code>
    at them — metadata is generated for you and packages are served from
    object storage via signed URLs.
  </p>
  <div class="flex justify-center gap-4">
    <.link navigate={~p"/repos"} class="btn btn-primary">Browse repositories</.link>
    <.link
      :if={!(@conn.assigns[:current_scope] && @conn.assigns.current_scope.user)}
      navigate={~p"/users/log-in"}
      class="btn btn-ghost"
    >
      Log in
    </.link>
  </div>
</div>
